<?xml version="1.0"?>
<package format="3">
  <name>slam</name><version>0.1.0</version>
  <description>SLAM, localization, dock mapping, snapshots, and wheel/IMU odometry</description>
  <maintainer email="maintainers@example.invalid">Project contributors</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>interfaces</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend><exec_depend>launch_ros</exec_depend>
  <test_depend>python3-pytest</test_depend><test_depend>python3-yaml</test_depend>
  <test_depend>tf2_msgs</test_depend>
  <test_depend>builtin_interfaces</test_depend>
  <export><build_type>ament_python</build_type></export>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
</package>
